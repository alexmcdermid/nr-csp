# VSCODE, Intellij and Eclipse ignore
**/*.vscode
.idea/
**/local.*
**/.classpath
**/.project
**/.settings/
.smarttomcat/
apt2-war.iml

# Local java stuff to ignore
**/target/
**/lib*
**build-pom.xml**
**pom-build.xml**
**build.xml**
**ivy.xml**
**/context.xml

# Polaris pipeline stuff to ginore
playbooks/collections/
.yo-rc.json
.DS_Store

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
/backend/sonar-project.properties
/frontend/sonar-project.properties
/backend/sonar-scanner.properties
/frontend/sonar-scanner.properties
/frontend/.scannerwork/**
/backend/.scannerwork/**

**/application.properties
**/amplifyconfiguration.json

.claude
.worktrees

.github
# Stray local notes/scratch markdown is ignored by default; the repo's own
# documentation is un-ignored explicitly. Already-tracked files (CONTRIBUTING.md,
# docs/**, frontend/e2e/**) are unaffected by this rule, but a NEW doc at the root
# needs a negation here or `git add` will silently skip it.
**.md
!README.md
!ARCHITECTURE.md
!SECURITY.md
!docs/fam-keycloak-migration.md
**.log
**.iml

# Playwright e2e artifacts
/frontend/playwright-report/
/frontend/test-results/

# Superpowers skill artifacts
.superpowers/
/backend/certs/*

# GitHub IaC — secret values must never be committed
github-state/*.secrets.env
